{
  "name": "flux-cd-mcp",
  "version": "0.1.0",
  "description": "MCP server for Flux CD operations on Kubernetes clusters",
  "type": "module",
  "bin": {
    "flux-cd-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
